#!/usr/bin/env bash
# Script to install dotfiles & personal environment
# Author: IR-MB
# URL: https://github.com/Irmb7108/dotfiles

# Colors
CRE=$(tput setaf 1)
CYE=$(tput setaf 3)
CGR=$(tput setaf 2)
CBL=$(tput setaf 4)
BLD=$(tput bold)
CNC=$(tput sgr0)

# Paths
BACKUP_FOLDER="$HOME/.RiceBackup/$(date +%Y%m%d-%H%M%S)"
LOG_FILE="$HOME/dotfiles_install.log"

log() {
    echo "$(date): $1" | tee -a "$LOG_FILE"
}

logo() {
    local text="${1:?}"
    echo -e "\n\033[1;32m
            ██╗██████╗       ███╗   ███╗██████╗
            ██║██╔══██╗      ████╗ ████║██╔══██╗
            ██║██████╔╝█████╗██╔████╔██║██████╔╝
            ██║██╔══██╗╚════╝██║╚██╔╝██║██╔══██╗
            ██║██║  ██║      ██║ ╚═╝ ██║██████╔╝
            ╚═╝╚═╝  ╚═╝      ╚═╝     ╚═╝╚═════╝
          \033[0m               Author: IR-MB
                   https://github.com/Irmb7108/dotfiles\n"
    echo -e "\033[1;32m${text}\033[0m\n"
}

# Check if running as root
if [ "$(id -u)" = 0 ]; then
    echo "${CRE}Error: This script MUST NOT be run as root user.${CNC}"
    exit 1
fi

logo "Welcome!"
printf "${CRE}This script will backup existing configs, install packages, personal LazyVim, and setup dotfiles.\n\n${CNC}"
while true; do
    read -rp "Do you wish to continue? [y/N]: " yn
    case $yn in
        [Yy]* ) break ;;
        [Nn]* ) exit ;;
        * ) printf "Please enter 'y' or 'n'\n" ;;
    esac
done
clear

# Update system
logo "Updating System Packages"
sudo pacman -Syu --noconfirm || { log "Error: System update failed"; exit 1; }

# Install yay if missing
if ! command -v yay &> /dev/null; then
    logo "Installing yay"
    sudo pacman -S --needed --noconfirm base-devel git || exit 1
    git clone https://aur.archlinux.org/yay-bin.git /tmp/yay-bin
    (cd /tmp/yay-bin && makepkg -si --noconfirm)
    rm -rf /tmp/yay-bin
fi

# Packages List
packages=(
    base-devel git go firefox zsh neovim psmisc bat man nomacs
    starship net-tools sublime-text lolcat tmux htop eza gimp key-mon fzf viewnior
    kitty haruna konsole alacritty rofi fish visual-studio-code-bin nekoray-bin
    harmonoid-bin tilix spotify tabby-bin discord telegram-desktop
    gedit vlc figlet ipython feh simplescreenrecorder flameshot
    audacious mpd ncmpcpp atril engrampa freetube-bin tty-clock nodejs npm
    karing-bin xclip xsel
)

logo "Installing Packages"
yay -S --needed --noconfirm "${packages[@]}"

# Backup existing configs
logo "Backing Up Existing Configurations"
mkdir -p "$BACKUP_FOLDER"
for cfg in bspwm polybar sxhkd alacritty kitty fish nvim rofi picom dunst; do
    if [ -d "$HOME/.config/$cfg" ]; then
        mv "$HOME/.config/$cfg" "$BACKUP_FOLDER/" && log "Backed up $cfg to $BACKUP_FOLDER"
    fi
done

# Clone and copy dotfiles
logo "Downloading Dotfiles"
rm -rf "$HOME/dotfiles"
git clone --depth=1 https://github.com/Irmb7108/dotfiles.git "$HOME/dotfiles" || { log "Error: Failed to clone dotfiles"; exit 1; }

mkdir -p "$HOME/.config"
[ -d "$HOME/dotfiles/.config" ] && cp -r "$HOME/dotfiles/.config/"* "$HOME/.config/" 2>/dev/null
[ -f "$HOME/dotfiles/home/.vimrc" ] && cp -f "$HOME/dotfiles/home/.vimrc" "$HOME/"
[ -f "$HOME/dotfiles/home/tmux.conf" ] && cp -f "$HOME/dotfiles/home/tmux.conf" "$HOME/.tmux.conf"

# Fonts
logo "Installing Fonts"
mkdir -p "$HOME/.local/share/fonts"
if [ ! -d "/tmp/SFMono-Fonts" ]; then
    git clone --depth=1 https://github.com/shaunsingh/SFMono-Nerd-Font-Ligaturized.git /tmp/SFMono-Fonts
    find /tmp/SFMono-Fonts -name "*.ttf" -exec cp {} "$HOME/.local/share/fonts/" \;
    rm -rf /tmp/SFMono-Fonts
    fc-cache -f >/dev/null 2>&1
fi

# Personal LazyVim
logo "Installing Personal LazyVim"
rm -rf "$HOME/.config/nvim"
git clone https://github.com/Irmb7108/nvim.git "$HOME/.config/nvim" && log "Personal LazyVim installed successfully"

# Oh My Zsh (Non-blocking unattended mode)
if [ ! -d "$HOME/.oh-my-zsh" ]; then
    logo "Installing Oh-My-Zsh"
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
fi

# Shell Choice
logo "Shell Configuration"
echo -e "${CYE}┌──────────────────────────────────────┐${CNC}"
echo -e "${CYE}│   ${BLD}Y${CNC}${CYE} = Yes → Switch to Fish           │"
echo -e "${CYE}│   ${BLD}N${CNC}${CYE} = No  → Keep Current/Zsh         │"
echo -e "${CYE}└──────────────────────────────────────┘${CNC}"
read -rp "$(echo -e "${CBL}➜ Set Fish as default shell? [Y/n]: ${CNC}")" answer
case "$answer" in
    [Yy]* ) 
        chsh -s "$(which fish)" && log "Default shell changed to fish"
        ;;
    * ) 
        log "Shell kept as default"
        ;;
esac
# Install ytdl-gui
logo "ytdl-gui Installation"
read -rp "$(echo -e "${CBL}➜ Do you want to install ytdl-gui? [y/N]: ${CNC}")" install_ytdl
if [[ $install_ytdl =~ ^[Yy]$ ]]; then
    log "Installing ytdl-gui and its dependencies..."

    # Install core system dependencies
    yay -S --needed --noconfirm python python-pip yt-dlp ffmpeg python-pyqt6

    rm -rf /tmp/ytdl-gui
    git clone https://github.com/Irmb7108/ytdl-gui.git /tmp/ytdl-gui || log "Error: Failed to clone ytdl-gui"

    # Install python requirements if exists
    if [ -f "/tmp/ytdl-gui/requirements.txt" ]; then
        pip install -r /tmp/ytdl-gui/requirements.txt --break-system-packages 2>/dev/null || pip install -r /tmp/ytdl-gui/requirements.txt
    fi

    # Setup application files
    if [ -f "/tmp/ytdl-gui/setup.py" ]; then
        pip install /tmp/ytdl-gui --break-system-packages 2>/dev/null || pip install /tmp/ytdl-gui
    elif [ -f "/tmp/ytdl-gui/install.sh" ]; then
        chmod +x /tmp/ytdl-gui/install.sh
        bash /tmp/ytdl-gui/install.sh
    else
        mkdir -p "$HOME/.local/bin" "$HOME/.local/share/applications"
        rm -rf "$HOME/.local/share/ytdl-gui"
        cp -r /tmp/ytdl-gui "$HOME/.local/share/ytdl-gui"
        find "$HOME/.local/share/ytdl-gui" -maxdepth 2 -type f -name "*.py" -exec chmod +x {} \;

        # Create executable symlink in ~/.local/bin
        main_file=$(find "$HOME/.local/share/ytdl-gui" -maxdepth 2 -type f -name "main.py" -o -name "app.py" -o -name "*gui*.py" | head -n 1)
        if [ -n "$main_file" ]; then
            ln -sf "$main_file" "$HOME/.local/bin/ytdl-gui"

            # Create Desktop Entry for App Launcher / Rofi
            cat <<EOF > "$HOME/.local/share/applications/ytdl-gui.desktop"
[Desktop Entry]
Name=YTDL GUI
Comment=YouTube Downloader GUI
Exec=python3 $main_file
Icon=download
Terminal=false
Type=Application
Categories=AudioVideo;Network;
EOF
            chmod +x "$HOME/.local/share/applications/ytdl-gui.desktop"
        fi
    fi

    rm -rf /tmp/ytdl-gui
    log "ytdl-gui setup completed."
fi

read -rp "$(echo -e "${CBL}➜ Reboot now? [y/N]: ${CNC}")" reboot_choice
[[ $reboot_choice =~ ^[Yy]$ ]] && sudo reboot
